# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template (.env.example)
# Copy this file to .env or backend/.env and customize as needed.
# ==============================================================================

# Active LLM Provider: 'ollama' (default local), 'anthropic', or 'openai'
LLM_PROVIDER=ollama

# Default model identifiers
# Local Ollama recommendations: 'qwen2.5:3b', 'llama3.2:3b', 'deepseek-r1:1.5b'
LLM_MODEL=qwen2.5:3b

# Local Embedding Model (nomic-embed-text recommended)
EMBEDDING_MODEL=nomic-embed-text

# Ollama local endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Dedicated storage path for local LLM models (Optional, defaults to D:\LLMs\ollama_store)
OLLAMA_MODELS=D:\LLMs\ollama_store

# Optional Cloud API Keys (Leave blank for 100% offline local Ollama operation)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database Connection (Supabase PostgreSQL or local async SQLite)
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./lenny_growth.db

# Supabase Cloud Configuration (Optional for cloud sync, replace with your credentials)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# S3 Bucket for Chat Threads & Uploads (AWS S3 or Supabase Storage S3-compatible)
S3_BUCKET_NAME=lenny-growth-chats
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=

# Observability and Timeouts
LOG_LEVEL=INFO
REQUEST_TIMEOUT_S=120
